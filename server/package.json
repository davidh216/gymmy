{
  "name": "gymmy-backend",
  "version": "1.0.0",
  "description": "Backend server for Gymmy's Phase 4: 1% Better Core System - ML-powered improvement detection and analytics",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "docker:build": "docker build -t gymmy-backend .",
    "docker:run": "docker run -p 3001:3001 gymmy-backend",
    "deploy:prod": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "redis": "^4.6.10",
    "pg": "^8.11.3",
    "mongoose": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "joi": "^17.11.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.4",
    "bull": "^4.12.0",
    "ioredis": "^5.3.2",
    "prometheus-client": "^15.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "aws-sdk": "^2.1490.0",
    "google-cloud-storage": "^7.7.0",
    "nodemailer": "^6.9.7",
    "twilio": "^4.19.0",
    "stripe": "^14.7.0",
    "firebase-admin": "^12.0.0",
    "elasticsearch": "^16.7.3",
    "kafka-node": "^5.0.0",
    "apollo-server-express": "^3.12.1",
    "graphql": "^16.8.1",
    "type-graphql": "^2.0.0-beta.3",
    "reflect-metadata": "^0.1.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/redis": "^4.0.11",
    "@types/pg": "^8.10.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/moment": "^2.13.0",
    "@types/joi": "^17.2.3",
    "@types/node-cron": "^3.0.11",
    "@types/multer": "^1.4.11",
    "@types/sharp": "^0.32.0",
    "@types/nodemailer": "^6.4.14",
    "@types/elasticsearch": "^5.0.40",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "private": true
}
